<?xml version="1.0" encoding="UTF-8"?>
<!-- Main axis (W-E): 2 lanes per direction plus a left-turn lane on the approaches.
     Cross street (N-S): 2 lanes on the approaches, 1 lane out. 50 km/h everywhere. Sidewalks are added by netconvert. -->
<edges>
    <edge id="w_in"  from="W" to="C" numLanes="3" speed="13.89" priority="3"/>
    <edge id="w_out" from="C" to="W" numLanes="2" speed="13.89" priority="3"/>
    <edge id="e_in"  from="E" to="C" numLanes="3" speed="13.89" priority="3"/>
    <edge id="e_out" from="C" to="E" numLanes="2" speed="13.89" priority="3"/>
    <edge id="n_in"  from="N" to="C" numLanes="2" speed="13.89" priority="2"/>
    <edge id="n_out" from="C" to="N" numLanes="1" speed="13.89" priority="2"/>
    <edge id="s_in"  from="S" to="C" numLanes="2" speed="13.89" priority="2"/>
    <edge id="s_out" from="C" to="S" numLanes="1" speed="13.89" priority="2"/>
</edges>
